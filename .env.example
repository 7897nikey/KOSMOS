# API 키 양식. 복사해서 각자 자기 키를 넣는다:  cp .env.example .env
# .env는 git에 올라가지 않는다(.gitignore). 키를 커밋·메신저에 붙이지 않는다.
#
# 분석·실험(experiments/, silicon.py)에는 키가 필요 없다. 새 응답을 수집할 때만 쓴다(유료, 팀 합의 후).
# 쓰는 법(KOSMOS 루트에서, 실행기 실행 전):  set -a; . ./.env; set +a

# K-EXAONE 2.5 — LG 공식 무료 API (https://www.lgresearch.ai 에서 발급)
#   실행기: research/design_v2_20261112/team_template/run_exaone_team.py, kgss_exaone_run.py
EXAONE_API_KEY=

# DeepSeek V4.1 Flash — OpenGateway (콘솔에서 사용할 모델을 허용 목록에 넣어야 한다)
#   실행기: research/design_v2_20261112/runners/run_deepseek_eco.py, compare_eco_ultrafast.py
OPENGATEWAY_API_KEY=

# Claude Haiku 5.5 — Anthropic (Message Batches)
#   실행기: research/design_v2_20261112/runners/run_haiku_batch.py
ANTHROPIC_API_KEY=

